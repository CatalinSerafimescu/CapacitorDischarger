* 600V Capacitor Discharger — PM-128 divider check (scenario H)
* Template placeholders: NAME OUTCSV MODELSLIB (double-brace form)
* Sweeps HVp 0→600 V into two copies of the 10 000:1 divider:
*   n_sigout   — normal (R_sigb1 ∥ R_sigb2 = 50 Ω, D_clamp, PM-128 input 100 MΩ)
*   n_sigout_f — fault: both bottom resistors open; D_clamp must hold the meter input low
.include {{MODELSLIB}}

V_HVp   HVp 0 0

R_sig1  HVp n_sig2 100k
R_sig2  n_sig2 n_sig3 100k
R_sig3  n_sig3 n_sig4 100k
R_sig4  n_sig4 n_sig5 100k
R_sig5  n_sig5 n_sigout 100k
R_sigb1 n_sigout 0 100
R_sigb2 n_sigout 0 100
D_clamp n_sigout 0 D1N4007
R_dvm   n_sigout 0 100Meg

R_fsig  HVp n_sigout_f 500k
D_fcl   n_sigout_f 0 D1N4007
R_fdvm  n_sigout_f 0 100Meg

.dc V_HVp 0 600 1

.save V(HVp) V(n_sigout) V(n_sigout_f)

.control
run
wrdata {{OUTCSV}} V(HVp) V(n_sigout) V(n_sigout_f)
quit
.endc

.end
