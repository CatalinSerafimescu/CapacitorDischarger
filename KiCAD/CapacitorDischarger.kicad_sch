	(text "1. INPUT + REVERSE-POLARITY BRIDGE + FUSE"
		(exclude_from_sim no)
		(at 10.16 15.24 0)
		(effects
				(font
					(size 2 2)
				)
				(justify left top)
			)
		(uuid "41999b62-252d-5a17-8390-aa817533378b")
	)
	(text "J1/J2 = panel banana sockets (off-board), wired to J3/J4 with 1 mm² silicone wire (0.6/1 kV).\nBoth poles of J3 = PROBE_A, both poles of J4 = PROBE_B: two blocks keep the input leads apart."
		(exclude_from_sim no)
		(at 10.16 76.2 0)
		(effects
				(font
					(size 1.27 1.27)
				)
				(justify left top)
			)
		(uuid "5e828986-8c80-54bc-aa31-6a605b940f76")
	)
	(text "F1: ESKA 1038820\n10.3×38 mm, 2× Schurter\nCSO 0751.0506 clips"
		(exclude_from_sim no)
		(at 101.6 45.72 0)
		(effects
				(font
					(size 1.27 1.27)
				)
				(justify left top)
			)
		(uuid "9f9c4c9c-8fb1-5e49-8d44-20e8b6028f7a")
	)
	(text "2. SLOW PATH"
		(exclude_from_sim no)
		(at 142.24 15.24 0)
		(effects
				(font
					(size 2 2)
				)
				(justify left top)
			)
		(uuid "87929c66-7548-5ce7-9fc5-bcaf13fbf65f")
	)
	(text "5 × 4.7 kΩ / 5 W wirewound\n= 23.5 kΩ, 25 mA at 600 V"
		(exclude_from_sim no)
		(at 142.24 73.66 0)
		(effects
				(font
					(size 1.27 1.27)
				)
				(justify left top)
